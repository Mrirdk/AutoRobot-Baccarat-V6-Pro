<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/robotRootContainer"
    android:layout_width="290dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mini_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Drag Header with Animated Robot Mascot -->
    <LinearLayout
        android:id="@+id/robotHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/flOverlayRobotBox"
            android:layout_width="56dp"
            android:layout_height="56dp">

            <View
                android:id="@+id/viewOverlayRobotAura"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_robot_aura" />

            <ImageView
                android:id="@+id/ivOverlayRobot"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="Robot AI"
                android:src="@drawable/ic_robot_cutout" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ROBOT AI V6 PRO"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOverlayCoinBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="999 Xu"
                    android:textColor="@color/accent_gold"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTimingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="CHỜ KHÓA KHUNG CẦU..."
                android:textColor="@color/accent_emerald"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCloseOverlay"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@android:color/transparent"
            android:padding="0dp"
            android:text="✕"
            android:textColor="#EF4444"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Live Result Announcement Banner -->
    <TextView
        android:id="@+id/tvResultAnnouncement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_result_banner"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        android:text="KẾT QUẢ: ĐANG ĐỌC BẢNG CẦU..."
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Robot Speech Bubble (Callout & Entry Signal) -->
    <LinearLayout
        android:id="@+id/layoutRobotBubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_robot_bubble"
        android:orientation="vertical"
        android:padding="9dp">

        <TextView
            android:id="@+id/tvRobotStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kéo khung xanh vào bảng Big Road rồi bấm BẮT ĐẦU!"
            android:textColor="@color/accent_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMainRoadStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Thế cầu: Chưa đủ dữ liệu"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvMarkovProb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tỷ lệ: BANKER 50% | PLAYER 50%"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvRecentBeads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Cầu gần nhất: --"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Action Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnToggleScan"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_btn_emerald"
            android:text="BẮT ĐẦU"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="6dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnToggleTarget"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_outline_cyan"
            android:text="KHÓA KHUNG"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="6dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnResetRoad"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="0.8"
            android:background="@drawable/bg_btn_gold"
            android:text="LÀM MỚI"
            android:textColor="#090D16"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
